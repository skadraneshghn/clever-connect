# Application Configuration
# APP_MODE can be "client" or "server"
APP_MODE=client
PORT=8080
JWT_SECRET=super-secret-jwt-key-change-in-production
WS_HEARTBEAT_INTERVAL=5s

# SQLite Database Config (Used in "client" mode)
SQLITE_DB_PATH=data/client.db

# MySQL Database Config (Used in "server" mode)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB_NAME=clever_connect_server

# Seed Admin User Configuration
ADMIN_USERNAME=salman
ADMIN_PASSWORD=136517

# Cloudflare OAuth Integration
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
CLOUDFLARE_REDIRECT_URL=

# S3-Compatible Object Storage (Clever Cloud Cellar)
# When all three CELLAR_ADDON_* credentials are present, fetched files are
# mirrored to / streamed from the object store with parallel multipart uploads
# and HTTP Range passthrough. Leave blank to keep using local disk.
CELLAR_ADDON_HOST=
CELLAR_ADDON_KEY_ID=
CELLAR_ADDON_KEY_SECRET=
CELLAR_ADDON_BUCKET=clever-connect
CELLAR_ADDON_REGION=us-east-1

